{
  "name": "team-freeze-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Blocks pull requests from frozen GitHub teams unless a configured bypass label is present.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist && ncc build src/resolve-team-membership.ts -o dist/resolve-team-membership",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.11.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "eslint": {
      "@eslint/config-array": {
        "minimatch": {
          "brace-expansion": "^5.0.12"
        }
      },
      "minimatch": {
        "brace-expansion": "^5.0.12"
      }
    },
    "typescript-eslint": {
      "@typescript-eslint/eslint-plugin": {
        "@typescript-eslint/parser": {
          "@typescript-eslint/typescript-estree": {
            "minimatch": {
              "brace-expansion": "^5.0.12"
            }
          }
        },
        "@typescript-eslint/type-utils": {
          "@typescript-eslint/typescript-estree": {
            "minimatch": {
              "brace-expansion": "^5.0.12"
            }
          },
          "@typescript-eslint/utils": {
            "@typescript-eslint/typescript-estree": {
              "minimatch": {
                "brace-expansion": "^5.0.12"
              }
            }
          }
        },
        "@typescript-eslint/utils": {
          "@typescript-eslint/typescript-estree": {
            "minimatch": {
              "brace-expansion": "^5.0.12"
            }
          }
        }
      },
      "@typescript-eslint/parser": {
        "@typescript-eslint/typescript-estree": {
          "minimatch": {
            "brace-expansion": "^5.0.12"
          }
        }
      },
      "@typescript-eslint/typescript-estree": {
        "minimatch": {
          "brace-expansion": "^5.0.12"
        }
      },
      "@typescript-eslint/utils": {
        "@typescript-eslint/typescript-estree": {
          "minimatch": {
            "brace-expansion": "^5.0.12"
          }
        }
      }
    }
  }
}
